{
    "manifest_version": 3,
    "name": "PhishGuard Training",
    "version": "1.0",
    "description": "Anti-phishing extension with simulated attack training mode",
    "permissions": [
      "activeTab",
      "webNavigation",
      "storage",
      "scripting",
      "tabs",
      "alarms"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "content_scripts": [
      {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["training/*.html", "images/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }