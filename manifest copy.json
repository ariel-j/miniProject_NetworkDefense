{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0",
  "description": "Anti-Phishing Training Tool",
  "icons": {
    "16": "icons/Logo.png",
    "48": "icons/Logo.png",
    "128": "icons/Logo.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/Logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content-styles.js",
        "content-templates.js", 
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "icons/*",
        "learning/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}