{
  "name": "ThreatDetection",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "The URL that was analyzed"
    },
    "threat_type": {
      "type": "string",
      "enum": [
        "phishing",
        "malware",
        "suspicious",
        "safe"
      ],
      "description": "Type of threat detected"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence level of the detection (0-100)"
    },
    "threat_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of indicators that flagged this as a threat"
    },
    "user_response": {
      "type": "string",
      "enum": [
        "blocked",
        "proceeded",
        "reported"
      ],
      "description": "How the user responded to the threat"
    },
    "is_simulation": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was a training simulation"
    },
    "response_time": {
      "type": "number",
      "description": "Time taken to respond in seconds"
    }
  },
  "required": [
    "url",
    "threat_type",
    "confidence_score"
  ]
}