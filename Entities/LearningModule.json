{
  "name": "LearningModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the learning module"
    },
    "category": {
      "type": "string",
      "enum": [
        "basics",
        "email_security",
        "web_safety",
        "social_engineering",
        "advanced_threats"
      ],
      "description": "Category of the learning content"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "Difficulty level"
    },
    "content": {
      "type": "string",
      "description": "Main content of the module"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key learning points"
    },
    "quiz_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "completion_time": {
      "type": "number",
      "description": "Estimated completion time in minutes"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category",
    "difficulty",
    "content"
  ]
}