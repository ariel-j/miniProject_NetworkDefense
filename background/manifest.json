{
  "manifest_version": 3,
  "name": "PhishGuard Training",
  "version": "1.2.0",
  "description": "Anti-phishing extension with simulated attack training mode",
  
  "permissions": [
    "activeTab",
    "webNavigation", 
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "notifications"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/Logo.png",
      "48": "icons/Logo.png", 
      "128": "icons/Logo.png"
    }
  },
  
  "icons": {
    "16": "icons/Logo.png",
    "48": "icons/Logo.png",
    "128": "icons/Logo.png"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content-styles.js",
        "content/content-templates.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "training/*.html",
        "learning/*.html", 
        "learning/*.css",
        "learning/*.js",
        "dashboard/*.html",
        "dashboard/*.css", 
        "dashboard/*.js",
        "background/*.js",
        "images/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}